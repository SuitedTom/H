VITE_APP_NAME="Stick Nodes Animation Forge"

# ==============================================================================
# MASS & SCIENTIFIC MASS VARIATIONS ENVIRONMENT CONFIGURATION
# ==============================================================================
# Mass is a fundamental property of matter measuring substance amount and resistance
# to acceleration. Standard SI Unit: Kilograms (kg).

# ------------------------------------------------------------------------------
# 1. CORE PHYSICAL CONSTANTS & EARTH GRAVITATIONAL PARAMETERS
# ------------------------------------------------------------------------------
# Standard acceleration due to gravity on Earth surface (g) in m/s^2
VITE_PHYSICS_GRAVITY_EARTH_MPS2=9.80665
# Speed of light in vacuum (c) in m/s (used for mass-energy equivalence and relativistic mass)
VITE_PHYSICS_SPEED_OF_LIGHT_MPS=299792458
# Newtonian Gravitational Constant (G) in m^3 kg^-1 s^-2
VITE_PHYSICS_GRAVITATIONAL_CONSTANT=6.67430e-11
# Reduced Planck Constant (hbar) in J·s
VITE_PHYSICS_HBAR_JOULE_SEC=1.054571817e-34

# ------------------------------------------------------------------------------
# 2. FUNDAMENTAL MASS & WEIGHT CONVERSIONS (m = F/a, m = W/g, W = mg)
# ------------------------------------------------------------------------------
# Default human character rest mass in kilograms (kg)
VITE_MASS_DEFAULT_CHARACTER_KG=70.0
# Reference object mass in kilograms (kg)
VITE_MASS_REFERENCE_OBJECT_KG=10.0
# Gravity acceleration default for weight calculations (m/s^2)
VITE_MASS_GRAVITY_ACCELERATION_G_MPS2=9.80665

# ------------------------------------------------------------------------------
# 3. INERTIAL MASS & DYNAMICS (F = m_i * a, p = m_i * v, I = m_i * r^2, tau = I * alpha)
# ------------------------------------------------------------------------------
# Inertial Mass: Object's resistance to a change in motion under applied force
VITE_INERTIAL_MASS_DEFAULT_KG=70.0
# Standard applied force in Newtons (N)
VITE_INERTIAL_APPLIED_FORCE_N=100.0
# Default motion velocity in m/s
VITE_INERTIAL_VELOCITY_MPS=5.0
# Reference radius for rotational moment of inertia calculation (meters)
VITE_INERTIAL_RADIUS_METERS=0.5
# Applied rotational torque in Newton-meters (N·m)
VITE_INERTIAL_TORQUE_NM=5.0

# ------------------------------------------------------------------------------
# 4. GRAVITATIONAL MASS & EQUIVALENCE PRINCIPLE
# ------------------------------------------------------------------------------
# Active Gravitational Mass: Creates a gravitational field (e.g. Earth mass in kg)
VITE_GRAVITATIONAL_MASS_ACTIVE_EARTH_KG=5.9722e24
# Passive Gravitational Mass: Feels an external gravitational pull (kg)
VITE_GRAVITATIONAL_MASS_PASSIVE_KG=70.0
# Mean Earth radius distance for local weight / gravitational force (meters)
VITE_GRAVITATIONAL_DISTANCE_METERS=6371000.0
# Weak Equivalence Principle Ratio Verification Tolerance (|m_i / m_g - 1.0| < tol)
VITE_GRAVITATIONAL_EQUIVALENCE_TOLERANCE=1.0e-12

# ------------------------------------------------------------------------------
# 5. REST MASS & MASS-ENERGY EQUIVALENCE (E_0 = m_0 * c^2)
# ------------------------------------------------------------------------------
# Rest Mass / Invariant Mass (m_0): Frame-independent mass measured in rest frame (kg)
VITE_REST_MASS_KG=70.0
# Energy conversion constant: Joules per Megaelectronvolt (J/MeV)
VITE_JOULES_PER_MEV=1.602176634e-13
# Nuclear Binding Energy Mass Defect reference delta m (kg)
VITE_MASS_DEFECT_REFERENCE_KG=0.001

# ------------------------------------------------------------------------------
# 6. RELATIVISTIC MASS & LORENTZ DYNAMICS (m_rel = gamma * m_0, gamma = 1 / sqrt(1 - v^2/c^2))
# ------------------------------------------------------------------------------
# High-velocity relativistic particle rest mass (kg)
VITE_RELATIVISTIC_REST_MASS_KG=1.0
# Velocity as fraction of speed of light (v / c)
VITE_RELATIVISTIC_VELOCITY_FRACTION_C=0.80

# ------------------------------------------------------------------------------
# 7. SUB-CATEGORIES & SPECIALIZED SCIENTIFIC MASS VARIATIONS
# ------------------------------------------------------------------------------
# A. Reduced Mass (mu = m1 * m2 / (m1 + m2)) for two-body orbital/collision dynamics
VITE_REDUCED_MASS_PRIMARY_M1_KG=70.0
VITE_REDUCED_MASS_SECONDARY_M2_KG=20.0

# B. Hydrodynamic Added Mass (m_added = C_v * rho_fluid * V_displaced) in fluid mechanics
# Fluid density (e.g. fresh water at 1000 kg/m^3, air at 1.225 kg/m^3)
VITE_FLUID_DENSITY_KG_PER_M3=1000.0
# Displaced volume of fluid in cubic meters (m^3)
VITE_FLUID_DISPLACED_VOLUME_M3=0.05
# Added mass coefficient C_v (0.5 for sphere, 1.0 for cylinder)
VITE_HYDRODYNAMIC_ADDED_MASS_COEFF=0.50

# C. Effective Mass in Solid State / Lattice Physics (m* = hbar^2 / (d^2E / dk^2))
# Ratio of effective electron mass in crystal lattice to free electron rest mass (m* / m_e)
VITE_EFFECTIVE_LATTICE_MASS_RATIO=1.20

# ------------------------------------------------------------------------------
# 8. MASS DENSITY DISTRIBUTION TYPES (rho = m/V, sigma = m/A, lambda = m/L)
# ------------------------------------------------------------------------------
# Volumetric Mass Density (rho) in kg/m^3 (e.g., human muscle ~1060 kg/m^3, bone ~1850 kg/m^3)
VITE_MASS_DENSITY_VOLUMETRIC_KG_M3=1060.0
# Surface Mass Density (sigma) in kg/m^2
VITE_MASS_DENSITY_SURFACE_KG_M2=5.0
# Linear Mass Density (lambda) in kg/m
VITE_MASS_DENSITY_LINEAR_KG_M=2.5

# ------------------------------------------------------------------------------
# 9. SKELETAL CENTER OF MASS (R_CoM = sum(m_i * r_i) / sum(m_i))
# ------------------------------------------------------------------------------
# Total body weight percentage distribution for human stickfigure rig (17 nodes sum to 1.0)
VITE_RIG_MASS_PELVIS_RATIO=0.18
VITE_RIG_MASS_THIGH_RATIO=0.14
VITE_RIG_MASS_SHIN_RATIO=0.06
VITE_RIG_MASS_FOOT_RATIO=0.02
VITE_RIG_MASS_SPINE_RATIO=0.16
VITE_RIG_MASS_CHEST_RATIO=0.18
VITE_RIG_MASS_BICEP_RATIO=0.03
VITE_RIG_MASS_FOREARM_RATIO=0.02
VITE_RIG_MASS_HAND_RATIO=0.01
VITE_RIG_MASS_HEAD_RATIO=0.08

# ------------------------------------------------------------------------------
# 10. ASTROPHYSICAL & QUANTUM MASS SCALES
# ------------------------------------------------------------------------------
# Electron Rest Mass (m_e) in kg
VITE_MASS_ELECTRON_REST_KG=9.1093837015e-31
# Proton Rest Mass (m_p) in kg
VITE_MASS_PROTON_REST_KG=1.67262192369e-27
# Unified Atomic Mass Unit (u or Da) in kg
VITE_MASS_ATOMIC_UNIT_KG=1.66053906660e-27
# Planck Mass (m_p = sqrt(hbar * c / G)) in kg
VITE_MASS_PLANCK_KG=2.176434e-8
# Solar Mass (M_sun) in kg
VITE_MASS_SOLAR_KG=1.98847e30
